#!/usr/bin/env zsh
# claude: host-owned launcher that runs the newest installed Claude Code
# version. Replaces the installer's symlink so `claude update` from inside
# the sandbox (which only writes a new versions/<v> file) takes effect on the
# next launch without touching ~/.local/bin.
set -euo pipefail

versions_dir="${CLAUDE_VERSIONS_DIR:-${HOME}/.local/share/claude/versions}"
latest=$(print -l "${versions_dir}"/[0-9]*(N:t) | sort -V | tail -n 1)
if [[ -z "${latest}" ]]; then
    print -u2 "claude: no installed versions under ${versions_dir}"
    exit 1
fi
exec "${versions_dir}/${latest}" "$@"
