#!/usr/bin/env zsh
# sandbox-run: launch an agent under sandbox-exec.
#
# The base policy is generated by agent-safehouse (brew `agent-safehouse`,
# minimum 0.11.1); this repo owns only sandbox/ws-scope.sb plus the
# per-launch block rendered below, appended after every generated rule so
# its denies win (SBPL last-match-wins).
#
# Per-CWD workspace scope (multi-repo isolation):
#   ~/dev                              workspace via `ws workspace`; dev-scope block
#   ~/dev/.worktrees/<ws>              workspace from the path; dev-scope block
#   ~/dev/.worktrees/<ws>/<repo>[/..]  narrow grant: ~/dev/<repo> RO, its .git R/W
#   anything else                      workdir grant only
#
# Each launch is a session: id <epoch>-<pid>, a session directory under the
# state root (log.jsonl + broker queue), host-only meta for the broker, and
# the environment contract SANDBOX_SESSION_ID / SANDBOX_SESSION_LOG /
# WS_WORKSPACE exported inside.
#
# Usage:
#   sandbox-run claude [args...]
#   sandbox-run opencode [args...]
#
# Debug/test seams: SANDBOX_RUN_PRINT_POLICY=1 prints the rendered policy and
# exits; SANDBOX_RUN_AGENT_BIN overrides the agent binary; SANDBOX_STATE_ROOT
# overrides the state root (tests only).

set -euo pipefail

readonly MIN_SAFEHOUSE="0.11.1"
readonly HOME_DIR="${HOME}"
readonly WORKDIR="$(pwd -P)"
readonly DEV_DIR="${HOME_DIR}/dev"
readonly WT_ROOT="${DEV_DIR}/.worktrees"
readonly WS_BIN="${HOME_DIR}/.local/scripts/ws"
readonly SCOPE_SRC="${HOME_DIR}/dotfiles/sandbox/ws-scope.sb"
readonly STATE_ROOT="${SANDBOX_STATE_ROOT:-${HOME_DIR}/.local/state/agent-sandbox}"
readonly LOG_CAP_BYTES=$(( 20 * 1024 * 1024 ))
readonly LAUNCHER_PID=$$

die() { print -u2 "sandbox-run: $*"; exit 1 }

case "${1:-}" in
    claude|opencode) readonly AGENT="$1" ;;
    *) print -u2 "Usage: sandbox-run <claude|opencode> [args...]"; exit 1 ;;
esac
shift

# --- launch-directory refusal (SBOX-01) ---------------------------------------
case "${WORKDIR}" in
    /|"${HOME_DIR}"|"${WT_ROOT}") die "refusing to launch from ${WORKDIR}" ;;
esac
# SBPL string literals are double-quoted; a quote or backslash would break or
# inject rules.
if [[ "${WORKDIR}" =~ [\"\\] ]]; then
    die "workdir contains characters unsafe for sandbox policy injection: ${WORKDIR}"
fi

# --- host tool preconditions (SBOX-54) ----------------------------------------
command -v jq >/dev/null || die "jq not found on PATH (brew install jq)"
command -v safehouse >/dev/null || die "safehouse not found on PATH (brew install eugene1g/safehouse/agent-safehouse)"
SAFEHOUSE_VERSION=$(safehouse --version 2>/dev/null | awk 'NR==1{print $NF}')
if [[ "$(print -l "${MIN_SAFEHOUSE}" "${SAFEHOUSE_VERSION}" | sort -V | head -n 1)" != "${MIN_SAFEHOUSE}" ]]; then
    die "safehouse ${SAFEHOUSE_VERSION:-unknown} is older than the required ${MIN_SAFEHOUSE} (brew upgrade agent-safehouse)"
fi
[[ -r "${SCOPE_SRC}" ]] || die "scope file not found: ${SCOPE_SRC}"

# --- agent binary (SBOX-53) ---------------------------------------------------
BREW_BIN="$(command -v brew || true)"
BREW_PREFIX="${BREW_BIN:h:h}"
BREW_CACHE="${HOMEBREW_CACHE:-${HOME_DIR}/Library/Caches/Homebrew}"
if [[ -n "${SANDBOX_RUN_AGENT_BIN:-}" ]]; then
    AGENT_BIN="${SANDBOX_RUN_AGENT_BIN}"
elif ! AGENT_BIN="$(command -v "${AGENT}")"; then
    if [[ "${AGENT}" == opencode && -n "${BREW_BIN}" ]]; then
        AGENT_BIN="${BREW_PREFIX}/bin/opencode"
    else
        AGENT_BIN=""
    fi
fi
[[ -n "${AGENT_BIN}" && -x "${AGENT_BIN}" ]] || die "agent binary not found or not executable: ${AGENT_BIN:-${AGENT}}"

# --- workspace and repo resolution --------------------------------------------
ACTIVE_BRANCH=""
ACTIVE_REPO=""
if [[ "${WORKDIR}" == "${DEV_DIR}" ]]; then
    # `ws workspace` writes its recovery message to stderr; abort before any
    # rule is rendered so we never launch with a degraded grant.
    ACTIVE_BRANCH=$("${WS_BIN}" workspace) || exit 1
elif [[ "${WORKDIR}" == "${WT_ROOT}"/* ]]; then
    wt_parts=("${(@s:/:)${WORKDIR#${WT_ROOT}/}}")
    ACTIVE_BRANCH="${wt_parts[1]}"
    ACTIVE_REPO="${wt_parts[2]:-}"
fi
for part in "${ACTIVE_BRANCH}" "${ACTIVE_REPO}"; do
    if [[ "${part}" =~ [\"\\] ]]; then
        die "workspace path component unsafe for sandbox policy injection: ${part}"
    fi
done
if [[ -n "${ACTIVE_REPO}" ]] && ! git -C "${DEV_DIR}/${ACTIVE_REPO}" rev-parse --git-dir >/dev/null 2>&1; then
    die "${DEV_DIR}/${ACTIVE_REPO} is not a git repository (worktree ${WORKDIR} has no source repo)"
fi

if [[ -n "${ACTIVE_BRANCH}" ]]; then
    TOOLDIR="${WT_ROOT}/${ACTIVE_BRANCH}/.tools"
else
    TOOLDIR="${WORKDIR}/.tools"
fi

# --- scope emitters -----------------------------------------------------------
# Direct children of ~/dev that are git repos (symlinks followed, .worktrees
# skipped). Prints "<name>\t<real path>" per repo; rules are written against
# the real path because the kernel checks resolved paths.
list_dev_repos() {
    local dir
    for dir in "${DEV_DIR}"/*(-/N); do
        [[ "${dir:t}" == ".worktrees" ]] && continue
        [[ -d "${dir}/.git" ]] || continue
        printf '%s\t%s\n' "${dir:t}" "${dir:A}"
    done
}

# Hooks and config of a granted repo stay unwritable (SBOX-07, AD-08).
emit_git_guards() {
    local repo_path="$1"
    printf '(deny file-write* (subpath "%s/.git/hooks") (literal "%s/.git/config") (literal "%s/.git/config.worktree"))\n' \
        "${repo_path}" "${repo_path}" "${repo_path}"
}

# ~/dev broadly R/W (non-repo files), each repo working tree RO with .git R/W
# (so `git worktree add` from the source repo works), .worktrees denied then
# the active workspace re-allowed.
emit_dev_scope() {
    local branch="$1" name repo_path
    printf '\n;; Dev-scope isolation: active workspace = %s\n' "${branch}"
    printf '(allow file-read* file-write* (subpath "%s"))\n' "${DEV_DIR}"
    while IFS=$'\t' read -r name repo_path; do
        [[ -z "${name}" ]] && continue
        if [[ "${repo_path}" =~ [\"\\] ]]; then
            die "~/dev repo path unsafe for policy injection: ${repo_path}"
        fi
        printf ';; Repo lockdown: %s\n' "${name}"
        printf '(deny file-read* file-write* (subpath "%s"))\n' "${repo_path}"
        printf '(allow file-read* (subpath "%s"))\n' "${repo_path}"
        printf '(allow file-read* file-write* (subpath "%s/.git"))\n' "${repo_path}"
        emit_git_guards "${repo_path}"
    done < <(list_dev_repos)
    printf ';; Worktrees lockdown\n'
    printf '(deny file-read* file-write* (subpath "%s"))\n' "${WT_ROOT}"
    printf '(allow file-read* (literal "%s"))\n' "${WT_ROOT}"
    printf '(allow file-read* (literal "%s/%s"))\n' "${WT_ROOT}" "${branch}"
    printf '(allow file-read* file-write* (subpath "%s/%s"))\n' "${WT_ROOT}" "${branch}"
}

# Narrow single-repo grant for ~/dev/.worktrees/<ws>/<repo>: source repo RO,
# its .git R/W; the rest of ~/dev stays outside the sandbox.
emit_worktree_repo_scope() {
    local repo="$1" ancestor part
    local repo_path="${DEV_DIR}/${repo}"
    repo_path="${repo_path:A}"
    if [[ "${repo_path}" =~ [\"\\] ]]; then
        die "source repo path unsafe for policy injection: ${repo_path}"
    fi
    printf '\n;; Worktree injection: source repo = %s\n' "${repo}"
    printf '(allow file-read* (literal "%s"))\n' "${DEV_DIR}"
    printf '(allow file-read* (subpath "%s"))\n' "${repo_path}"
    printf '(allow file-read* file-write* (subpath "%s/.git"))\n' "${repo_path}"
    emit_git_guards "${repo_path}"
    # The generator snapshots sibling linked worktrees as readable; other
    # workspaces must stay invisible (SBOX-03), so lock .worktrees down and
    # re-open only the path to the workdir.
    printf ';; Workspace lockdown: only %s is visible under %s\n' "${WORKDIR}" "${WT_ROOT}"
    printf '(deny file-read* file-write* (subpath "%s"))\n' "${WT_ROOT}"
    ancestor="${WT_ROOT}"
    printf '(allow file-read* (literal "%s"))\n' "${ancestor}"
    for part in "${(@s:/:)${WORKDIR#${WT_ROOT}/}}"; do
        ancestor="${ancestor}/${part}"
        printf '(allow file-read* (literal "%s"))\n' "${ancestor}"
    done
    printf '(allow file-read* file-write* (subpath "%s"))\n' "${WORKDIR}"
}

# Session log append, own broker queue, shared inbox, tooldir (SBOX-17/35/44).
emit_session_grants() {
    local dir="$1" ancestor="" part
    printf '\n;; Session grants: %s\n' "${SESSION_ID}"
    for part in "${(@s:/:)STATE_ROOT}"; do
        [[ -z "${part}" ]] && continue
        ancestor="${ancestor}/${part}"
        printf '(allow file-read* (literal "%s"))\n' "${ancestor}"
    done
    printf '(allow file-read* (literal "%s/sessions") (literal "%s"))\n' "${STATE_ROOT}" "${dir}"
    printf '(allow file-read* file-write* (literal "%s/log.jsonl"))\n' "${dir}"
    printf '(allow file-read* file-write* (subpath "%s/requests") (subpath "%s/results"))\n' "${dir}" "${dir}"
    printf '(allow file-read* file-write* (subpath "%s/inbox"))\n' "${STATE_ROOT}"
    printf '(allow file-read* file-write* (subpath "%s"))\n' "${TOOLDIR}"
}

# --- session identity (AD-17) -------------------------------------------------
write_meta() {
    local tmp="${STATE_ROOT}/host/meta/.${SESSION_ID}.tmp"
    jq -n --arg sid "${SESSION_ID}" --arg ws "${ACTIVE_BRANCH}" --arg workdir "${WORKDIR}" \
        --arg started "${STARTED}" --argjson pid "${1:-0}" --argjson sup "${2:-0}" \
        '{sid:$sid, ws:$ws, workdir:$workdir, started:$started, agent_pid:$pid, supervisor_pid:$sup}' > "${tmp}"
    mv -f "${tmp}" "${STATE_ROOT}/host/meta/${SESSION_ID}.json"
}

host_event() {
    jq -nc --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg event "$1" --arg sid "${SESSION_ID}" \
        '{ts:$ts, event:$event, session:$sid}' >> "${STATE_ROOT}/host/events.jsonl"
}

umask 077
mkdir -p "${STATE_ROOT}/sessions" "${STATE_ROOT}/inbox" "${STATE_ROOT}/host/meta" "${STATE_ROOT}/host/policy"
STARTED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
SESSION_ID="$(date +%s)-$$"
if ! mkdir "${STATE_ROOT}/sessions/${SESSION_ID}" 2>/dev/null; then
    SESSION_ID="${SESSION_ID}-${RANDOM}"
    mkdir "${STATE_ROOT}/sessions/${SESSION_ID}"
fi
readonly SESSION_ID
readonly SESSION_DIR="${STATE_ROOT}/sessions/${SESSION_ID}"
readonly SESSION_LOG="${SESSION_DIR}/log.jsonl"
readonly SCOPE_FILE="${STATE_ROOT}/host/policy/${SESSION_ID}.scope.sb"
readonly POLICY_FILE="${STATE_ROOT}/host/policy/${SESSION_ID}.sb"
mkdir "${SESSION_DIR}/requests" "${SESSION_DIR}/results"
: > "${SESSION_LOG}"
chmod 700 "${SESSION_DIR}"
write_meta 0

cleanup_session() {
    rm -rf "${SESSION_DIR}/requests" "${SESSION_DIR}/results"
    rm -f "${SCOPE_FILE}" "${POLICY_FILE}"
}

# --- policy -------------------------------------------------------------------
{
    if [[ -n "${ACTIVE_REPO}" ]]; then
        emit_worktree_repo_scope "${ACTIVE_REPO}"
    elif [[ -n "${ACTIVE_BRANCH}" ]]; then
        emit_dev_scope "${ACTIVE_BRANCH}"
    fi
    emit_session_grants "${SESSION_DIR}"
    printf '\n'
    sed "s|SANDBOX_WORKDIR|${WORKDIR}|g" "${SCOPE_SRC}"
} > "${SCOPE_FILE}"

ro_dirs=()
[[ -n "${BREW_BIN}" ]] && ro_dirs+=("${BREW_PREFIX}")
[[ -n "${TERMINFO:-}" && -d "${TERMINFO}" ]] && ro_dirs+=("${TERMINFO}")
safehouse_args=(
    --stdout
    --workdir="${WORKDIR}"
    --enable=docker,ssh,playwright-chrome,process-control,shell-init,keychain,clipboard
    --add-dirs="${BREW_CACHE}"
    --append-profile="${SCOPE_FILE}"
)
(( ${#ro_dirs} )) && safehouse_args+=(--add-dirs-ro="${(j.:.)ro_dirs}")
# The agent name (not the binary path) selects the generator's agent profile.
if ! safehouse "${safehouse_args[@]}" -- "${AGENT}" > "${POLICY_FILE}"; then
    cleanup_session
    die "policy generation failed"
fi

if [[ -n "${SANDBOX_RUN_PRINT_POLICY:-}" ]]; then
    cat "${POLICY_FILE}"
    cleanup_session
    rm -rf "${SESSION_DIR}" "${STATE_ROOT}/host/meta/${SESSION_ID}.json"
    exit 0
fi

# --- environment contract -----------------------------------------------------
export SANDBOX_SESSION_ID="${SESSION_ID}"
export SANDBOX_SESSION_LOG="${SESSION_LOG}"
export WS_WORKSPACE="${ACTIVE_BRANCH}"
export PATH="${TOOLDIR}/bin:${PATH}"
unset NPM_CONFIG_PREFIX
# COLUMNS is zsh-internal; export it so subprocesses (Node.js, tput) see the
# real width. Fall back to 80 when there is no TTY.
if (( ${COLUMNS:-0} == 0 )); then
    COLUMNS=$({ stty size </dev/tty; } 2>/dev/null | awk '{print $2}') || true
    (( ${COLUMNS:-0} > 0 )) || COLUMNS=80
fi
export COLUMNS

# --- process model (SBOX-09) --------------------------------------------------
# The agent is a child so terminal signals can be forwarded, its exit status
# propagated, and the session queue removed afterwards. The supervisor is a
# separate process that outlives a SIGKILLed launcher: it enforces the
# session-log cap host-side and stops once the agent or the launcher is gone.
supervise() {
    trap '' INT HUP TERM
    local size
    while kill -0 "${AGENT_PID}" 2>/dev/null && kill -0 "${LAUNCHER_PID}" 2>/dev/null; do
        sleep 1
        size=$(stat -f %z "${SESSION_LOG}" 2>/dev/null || print 0)
        if (( size > LOG_CAP_BYTES )); then
            tail -c "${LOG_CAP_BYTES}" "${SESSION_LOG}" > "${SESSION_LOG}.tmp" && mv -f "${SESSION_LOG}.tmp" "${SESSION_LOG}"
            host_event log-truncated
        fi
    done
}

forward() { kill -"$1" "${AGENT_PID}" 2>/dev/null || true }
trap 'forward INT' INT
trap 'forward TERM' TERM
trap 'forward HUP' HUP
trap 'forward WINCH' WINCH

sandbox-exec -f "${POLICY_FILE}" "${AGENT_BIN}" "$@" &
AGENT_PID=$!
supervise &
SUPERVISOR_PID=$!
write_meta "${AGENT_PID}" "${SUPERVISOR_PID}"

set +e
rc=0
while kill -0 "${AGENT_PID}" 2>/dev/null; do
    wait "${AGENT_PID}"
    rc=$?
done
kill -KILL "${SUPERVISOR_PID}" 2>/dev/null
cleanup_session
exit "${rc}"
