#!/usr/bin/env zsh
# sandbox-run: run a command so that, when launched under ~/dev, it can only
# change the active workspace. It enforces the ws rules with sandbox-exec:
#
#   - the workspace is `ws workspace` (the tmux session);
#   - its worktrees live in ~/dev/.worktrees/<workspace>/ (`/` becomes `-`);
#   - repos are enlisted there with `ws wt add`, which writes the worktree and
#     the primary clone's .git.
#
# Launched under ~/dev, everything stays readable and writable except:
#   - primary clone source: ~/dev/<repo> outside its .git is read-only, so a
#     repo changes only through its worktrees;
#   - other workspaces: ~/dev/.worktrees is read-only except the active
#     workspace's folder;
#   - renaming or deleting ~/dev, ~/dev/.worktrees or a clone.
#
# Launching inside another workspace's folder is refused. Launched outside
# ~/dev, the command runs unsandboxed.
#
# Primary clones are the direct children of ~/dev that hold .git when the
# command starts. The kernel checks resolved paths, so the rules name resolved
# paths: a symlinked ~/dev, ~/dev/.worktrees or ~/dev/<repo> is protected at
# its target (the symlink in $HOME itself is not).
#
# Known limits:
#   - a repo created under ~/dev after launch is not protected;
#   - every clone's .git is writable (ws wt add and commits need it), so a
#     session can move other workspaces' branches or edit .git/hooks and
#     .git/config.
#
# Usage: sandbox-run <command> [args...]

set -euo pipefail

readonly SANDBOX_EXEC=/usr/bin/sandbox-exec

die() {
    print -ru2 -- "sandbox-run: $*"
    exit 1
}

# find_clones <dev> <worktree root>: fill the caller's clone_entries (paths as
# listed under <dev>) and clone_targets (the same clones, resolved).
find_clones() {
    local dev="$1" wt="$2" dir target
    for dir in "${dev}"/*(ND-/); do
        [[ "${dir:t}" == .worktrees || ! -e "${dir}/.git" ]] && continue
        target="${dir:A}"
        # Rules on a clone inside the worktree root would override the
        # workspace rules, which are written after them.
        if [[ "${target}" == "${wt}" || "${target}" == "${wt}"/* ]]; then
            die "clone ${dir} resolves inside the worktree root: ${target}"
        fi
        clone_entries+=("${dir}")
        clone_targets+=("${target}")
    done
}

# is_within <path> <dir...>: true when <path> is one of the dirs or below one.
is_within() {
    local path="$1" dir
    shift
    for dir in "$@"; do
        [[ "${path}" == "${dir}" || "${path}" == "${dir}"/* ]] && return 0
    done
    return 1
}

# is_nested: true when the command already runs inside a sandbox, where macOS
# cannot apply a second one. The command then runs under that outer sandbox
# (normally the session that launched it). Any other failure means
# sandbox-exec is unusable: stop rather than run unprotected.
is_nested() {
    local err
    err=$("${SANDBOX_EXEC}" -p '(version 1)(allow default)' /usr/bin/true 2>&1) && return 1
    [[ "${err}" == *"sandbox_apply: Operation not permitted"* ]] && return 0
    die "sandbox-exec unusable: ${err}"
}

# active_workspace: print the workspace ws resolves (the tmux session).
active_workspace() {
    "${HOME}/.local/scripts/ws" workspace \
        || die "no workspace resolvable; launch from a workspace pane"
}

# check_launch_dir <workdir> <worktree root> <workspace> <workspace dir>:
# refuse a launch inside another workspace's folder.
check_launch_dir() {
    local workdir="$1" wt="$2" workspace="$3" ws_dir="$4" launched_in
    [[ "${workdir}" == "${wt}"/* ]] || return 0
    launched_in="${workdir#${wt}/}"
    launched_in="${launched_in%%/*}"
    if [[ "${launched_in}" != "${ws_dir}" ]]; then
        die "${workdir} is not in the active workspace ${workspace} (${wt}/${ws_dir})"
    fi
}

# check_policy_values <value...>: SBPL string literals are double-quoted, so
# refuse any value with a quote, backslash or control byte rather than escape.
check_policy_values() {
    local value
    for value in "$@"; do
        if [[ "${value}" == *[\"\\$'\1'-$'\37'$'\177']* ]]; then
            die "path unsafe for sandbox policy: ${value}"
        fi
    done
}

# build_profile <dev> <worktree root> <workspace dir>: print the SBPL profile
# for the caller's clone_entries and clone_targets. The last matching rule
# wins, so the workspace rules come after the clone rules.
build_profile() {
    local dev="$1" wt="$2" ws_dir="$3" clone entry
    print -r -- '(version 1)'
    print -r -- '(allow default)'
    # Seatbelt refuses setuid exec inside any sandbox. ps only reads process
    # state, so it runs unsandboxed; do not widen this to other binaries.
    print -r -- '(allow process-exec (with no-sandbox) (literal "/bin/ps"))'
    for clone in "${clone_targets[@]}"; do
        print -r -- "(deny file-write* (subpath \"${clone}\"))"
        print -r -- "(allow file-write* (subpath \"${clone}/.git\"))"
    done
    print -r -- "(deny file-write* (subpath \"${wt}\"))"
    # Not resolved on purpose: a session could replace its folder with a
    # symlink to a clone, and resolving it would open that clone next launch.
    print -r -- "(allow file-write* (subpath \"${wt}/${ws_dir}\"))"
    print -rn -- "(deny file-write-unlink (literal \"${dev}\") (literal \"${dev}/.worktrees\")"
    for entry in "${clone_entries[@]}"; do
        print -rn -- " (literal \"${entry}\")"
    done
    print -r -- ")"
}

main() {
    (( $# )) || die "usage: sandbox-run <command> [args...]"

    local dev wt workdir workspace ws_dir profile
    local -a clone_entries clone_targets
    dev="${HOME}/dev"
    dev="${dev:A}"
    wt="${dev}/.worktrees"
    wt="${wt:A}"
    workdir="$(pwd -P)"
    # Needed before the scope check: a launch inside a symlinked clone's
    # target counts as a launch under ~/dev.
    find_clones "${dev}" "${wt}"

    is_within "${workdir}" "${dev}" "${wt}" "${clone_targets[@]}" || exec "$@"
    is_nested && exec "$@"

    workspace="$(active_workspace)"
    # worktrunk's `{{ branch | sanitize }}` (worktrunk/.config/worktrunk/config.toml)
    # maps `/` and `\` to `-`; `\` is refused below anyway.
    ws_dir="${workspace//\//-}"
    if [[ -z "${ws_dir}" || "${ws_dir}" == (.|..) ]]; then
        die "workspace '${workspace}' is not a directory name"
    fi
    check_launch_dir "${workdir}" "${wt}" "${workspace}" "${ws_dir}"
    check_policy_values "${dev}" "${wt}" "${ws_dir}" "${clone_entries[@]}" "${clone_targets[@]}"

    # The session cannot create folders in the write-protected worktree root.
    mkdir -p -- "${wt}/${ws_dir}"

    profile="$(build_profile "${dev}" "${wt}" "${ws_dir}")"
    export WS_WORKSPACE="${workspace}"
    exec "${SANDBOX_EXEC}" -p "${profile}" "$@"
}

main "$@"
